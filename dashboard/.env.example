# Copy to .env.local and fill in (Supabase -> Project Settings -> API). Anon/publishable key ONLY.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Launcher (Mac only). Must be 127.0.0.1, not localhost: the launcher binds IPv4 only and localhost can resolve to ::1.
# Leave this line out entirely when hosted: Start/Stop, logs and port status are then hidden.
VITE_LAUNCHER_URL=http://127.0.0.1:5171
