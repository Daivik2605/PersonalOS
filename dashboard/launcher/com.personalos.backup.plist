<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personalos.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/daivik/Desktop/Daivik/PersonalOS/dashboard/launcher/backup.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- Sundays at 03:00. If the Mac is asleep then, launchd runs it when the Mac wakes. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/daivik/Desktop/Daivik/PersonalOS/dashboard/launcher/logs/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/daivik/Desktop/Daivik/PersonalOS/dashboard/launcher/logs/backup.log</string>
</dict>
</plist>
